# MCP_FLINK_AUTH_TOKENS_FILE — one caller per line (O2 phase A + optional B)
# Format:
#   callerId : sha256Hex(rawBearerToken) : jobsAllowCsv : jarsAllowCsv : readonly
#   [: flinkAuthHeader [: gatewayAuthHeader ]]
#
# Generate hash:  echo -n 'my-token' | sha256sum
# Or Java: TokenRegistry.sha256Hex("my-token")
#
# Prefer keeping outbound secrets in MCP_FLINK_CALLER_CREDENTIALS_FILE instead of fields 6–7.
#
# alice : REPLACE_WITH_SHA256_OF_ALICE_TOKEN : job-a,job-b : * : false
# bob   : REPLACE_WITH_SHA256_OF_BOB_TOKEN   : job-c : jar-1 : true
