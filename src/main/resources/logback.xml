<!-- Author: Viquar Khan -->
<configuration>
  <!-- All logs to STDERR — stdout is reserved for MCP JSON-RPC -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] trace=%X{trace:--} %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.github.vaquarkhan.flinkmcp" level="${MCP_FLINK_LOG_LEVEL:-INFO}"/>
  <logger name="org.eclipse.jetty" level="WARN"/>
  <logger name="org.eclipse.jetty.server.RequestLog" level="INFO"/>

  <root level="${MCP_FLINK_LOG_LEVEL:-INFO}">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
